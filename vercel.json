{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/llms.txt", "destination": "/api/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/api/llms-full.txt" },
    { "source": "/articles", "destination": "/index.html" },
    { "source": "/current-affairs", "destination": "/index.html" },
    { "source": "/current-affairs/:slug", "destination": "/index.html" },
    { "source": "/article/:number", "destination": "/index.html" },
    { "source": "/fundamental-rights", "destination": "/index.html" },
    { "source": "/fundamental-rights/:slug", "destination": "/index.html" },
    { "source": "/fundamental-duties", "destination": "/index.html" },
    { "source": "/directive-principles", "destination": "/index.html" },
    { "source": "/amendments", "destination": "/index.html" },
    { "source": "/amendments/:slug", "destination": "/index.html" },
    { "source": "/preamble", "destination": "/index.html" },
    { "source": "/quiz", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/learn", "destination": "/index.html" },
    { "source": "/exam-preparation", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/terms-and-conditions", "destination": "/index.html" },
    { "source": "/disclaimer", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ]
}
